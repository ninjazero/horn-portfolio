---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Fact from '../../components/Fact.astro';
import { getSortedWork } from '../../lib/work';

export async function getStaticPaths() {
  const projects = await getSortedWork();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'work'>;
  prev: CollectionEntry<'work'> | null;
  next: CollectionEntry<'work'> | null;
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());
const isDraft = d.status === 'draft';
// Internal review notes and unapproved copy are visible while developing and
// never ship in a build.
const dev = import.meta.env.DEV;
const showReflection = d.reflection && (d.reflection.approved || dev);

// Unverified claims and sources never ship; they appear only while developing.
const outcomes = d.outcomes.filter((o) => dev || o.evidence !== 'unverified');
const references = d.references.filter((r) => dev || r.status !== 'unverified');

const evidenceLabel = {
  verified: 'Verified',
  reported: 'Reported',
  observed: 'Observed in testing',
  unverified: 'Unverified',
  'in-progress': 'In progress',
} as const;

// Numbered citations: [n] links jump to the matching entry under Sources.
const refNumber = new Map(references.map((r, i) => [r.id, i + 1]));
const refTitle = new Map(references.map((r) => [r.id, r.title]));
const cite = (id?: string) =>
  id && refNumber.has(id) ? { n: refNumber.get(id)!, href: `#ref-${id}`, title: refTitle.get(id)! } : null;

const decisions = d.decisions.map((x) => (typeof x === 'string' ? { title: x } : x));
const richDecisions = decisions.some((x) => Object.keys(x).length > 1);
// Decision card rows, in reading order, for whichever fields are present.
const decisionRows = (x: (typeof decisions)[number]) =>
  (
    [
      ['Problem', 'problem'],
      ['Instead of', 'alternative'],
      ['Why it mattered', 'why'],
      ['What testing showed', 'findings'],
      ['Tradeoff', 'tradeoff'],
      ['Who decided', 'attribution'],
    ] as const
  )
    .filter(([, k]) => k in x && (x as Record<string, unknown>)[k])
    .map(([label, k]) => ({ label, text: (x as Record<string, string>)[k] }));
const showDecisions = decisions.length > 0 || (dev && isDraft);
const showOutcomes = outcomes.length > 0 || (dev && isDraft);
const approachHeading = d.approachHeading ?? 'Approach';

// "On this page" links, only for sections that render.
const toc = [
  { id: 'challenge', label: 'The challenge', show: true },
  { id: 'role', label: 'My role', show: Boolean(d.contributions || d.responsibilities.length) },
  { id: 'approach', label: approachHeading, show: true },
  { id: 'highlights', label: d.highlights?.heading ?? '', show: Boolean(d.highlights) },
  { id: 'decisions', label: 'Key decisions', show: showDecisions },
  { id: 'outcomes', label: 'Outcomes', show: showOutcomes },
  { id: 'timeline', label: 'Timeline', show: d.timeline.length > 0 },
  { id: 'reflection', label: 'Reflection', show: Boolean(showReflection) },
  { id: 'sources', label: 'Sources', show: references.length > 0 },
].filter((s) => s.show);
---

<BaseLayout title={d.title} description={d.deck ?? d.summary}>
  <div class="page">
    <a class="back" href="/work/"><Icon name="arrow-left" size={16} /> All work</a>

    <header class="head">
      {
        isDraft && (
          <p class="draft-banner">
            <strong>Draft · unverified.</strong> Details on this page are still being confirmed.
          </p>
        )
      }
      <p class="eyebrow">{d.eyebrow ?? d.category}</p>
      <h1>{d.headline ?? d.title}</h1>
      <p class="head__lead">{d.deck ?? d.summary}</p>
      <p class="byline">
        <span>Anthony Horn</span>
        <span><Fact value={d.role} /></span>
        <span>{d.organization}</span>
        <span><Fact value={d.timeframe} /></span>
      </p>
      {
        d.proof.length > 0 && (
          <ul role="list" class="proof">
            {d.proof.map((p) => {
              const c = cite(p.source);
              return (
                <li class={`proof__item proof__item--${p.evidence}`}>
                  {p.label}
                  {c && (
                    <a class="cite" href={c.href} aria-label={`Source ${c.n}: ${c.title}`}>
                      [{c.n}]
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
    </header>

    {
      d.cover && (
        <figure class="cover">
          <div class="cover__frame tail-mask">
            <Image
              src={d.cover}
              alt={d.coverAlt ?? ''}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 76rem) 70rem, 92vw"
              loading="eager"
            />
          </div>
          {d.coverCaption && <figcaption>{d.coverCaption}</figcaption>}
        </figure>
      )
    }
  </div>

  <div class="lower">
    <div class="page layout">
      <aside class="meta" aria-label="Project details">
        <section class="meta__card" aria-labelledby="glance">
          <h2 id="glance" class="meta__heading">At a glance</h2>
          <dl>
            <div>
              <dt>Organization</dt>
              <dd>{d.organization}</dd>
            </div>
            <div>
              <dt>Role</dt>
              <dd><Fact value={d.role} /></dd>
            </div>
            {
              d.team && (
                <div>
                  <dt>Team</dt>
                  <dd>{d.team}</dd>
                </div>
              )
            }
            <div>
              <dt>Timeframe</dt>
              <dd><Fact value={d.timeframe} /></dd>
            </div>
            <div>
              <dt>Technologies</dt>
              <dd>
                {
                  d.technologies.length ? (
                    <ul role="list" class="chips">
                      {d.technologies.map((t) => (
                        <li>
                          <Fact value={t} />
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <Fact />
                  )
                }
              </dd>
            </div>
          </dl>
        </section>

        <nav class="toc" aria-labelledby="toc-heading">
          <h2 id="toc-heading" class="meta__heading">On this page</h2>
          <ol role="list">
            {
              toc.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.label}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <article class="body">
        <section aria-labelledby="challenge">
          <h2 id="challenge">The challenge</h2>
          <p><Fact value={d.challenge} /></p>
          {
            d.challengePoints.length > 0 && (
              <ul class="list">
                {d.challengePoints.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            )
          }
          {
            d.challengeQuote && (
              <blockquote class="pullquote">
                <p>{d.challengeQuote}</p>
              </blockquote>
            )
          }
        </section>

        {
          d.contributions ? (
            <section aria-labelledby="role">
              <h2 id="role">My role</h2>
              {d.roleIntro ? (
                <p>{d.roleIntro}</p>
              ) : (
                <p>
                  This was a cross-team effort. To keep credit accurate, my own contributions are
                  listed separately from the wider team's.
                </p>
              )}
              <div class="split">
                <div class="split__col split__col--mine">
                  <h3>My contributions</h3>
                  <ul class="list">
                    {d.contributions.mine.map((m) => (
                      <li>
                        <Fact value={m} />
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="split__col">
                  <h3>Team contributions</h3>
                  <ul class="list">
                    {d.contributions.team.map((t) => (
                      <li>
                        <Fact value={t} />
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              {d.contributions.note && <p class="source-note">{d.contributions.note}</p>}
              {d.method && (
                <aside class="method" aria-label={d.method.heading}>
                  <h3>{d.method.heading}</h3>
                  <p>{d.method.text}</p>
                  {d.method.link && (
                    <a class="text-link" href={d.method.link.url} rel="noopener">
                      {d.method.link.label} <Icon name="arrow-right" size={16} />
                    </a>
                  )}
                </aside>
              )}
              {(() => {
                const c = cite(d.contributions.source);
                return (
                  c && (
                    <p class="source-note">
                      Attribution as described in{' '}
                      <a href={c.href}>
                        {c.title} [{c.n}]
                      </a>
                      .
                    </p>
                  )
                );
              })()}
            </section>
          ) : (
            d.responsibilities.length > 0 && (
              <section aria-labelledby="role">
                <h2 id="role">My role</h2>
                <ul class="list">
                  {d.responsibilities.map((r) => (
                    <li>
                      <Fact value={r} />
                    </li>
                  ))}
                </ul>
              </section>
            )
          )
        }

        <section aria-labelledby="approach">
          <h2 id="approach">{approachHeading}</h2>
          <p><Fact value={d.approach} /></p>
          {
            d.flow && (
              <figure class="flow">
                <p class="flow__label">{d.flow.label ?? 'Simplified architecture'}</p>
                <ol class="flow__steps">
                  {d.flow.steps.map((s) =>
                    typeof s === 'string' ? (
                      <li class="flow__step">{s}</li>
                    ) : (
                      <li class="flow__step flow__step--phase">
                        <span class="flow__title">{s.title}</span>
                        <span class="flow__text">{s.text}</span>
                      </li>
                    ),
                  )}
                </ol>
                {d.flow.outputs.length > 0 && (
                  <>
                    <p class="visually-hidden">Which then feeds:</p>
                    <ul role="list" class="flow__outputs">
                      {d.flow.outputs.map((o) => (
                        <li class="flow__output">{o}</li>
                      ))}
                    </ul>
                  </>
                )}
                {d.flow.loop && <p class="flow__loop">{d.flow.loop}</p>}
                {d.flow.caption && <figcaption>{d.flow.caption}</figcaption>}
              </figure>
            )
          }
        </section>

        {
          d.highlights && (
            <section aria-labelledby="highlights">
              <h2 id="highlights">{d.highlights.heading}</h2>
              {d.highlights.intro && <p>{d.highlights.intro}</p>}
              <ul
                role="list"
                class="highlights"
                data-cols={d.highlights.items.length % 3 === 0 ? 3 : 2}
              >
                {d.highlights.items.map((h) => (
                  <li class="highlight">
                    <h3>{h.title}</h3>
                    <p>{h.text}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {showDecisions && (
        <section aria-labelledby="decisions">
          <h2 id="decisions">Key decisions</h2>
          {
            decisions.length === 0 ? (
              <p>
                <Fact value="TODO — two or three decisions and the reasoning behind them" />
              </p>
            ) : richDecisions ? (
              <>
                <p>
                  {d.decisionsIntro ??
                    "These were team decisions; individual decision-makers aren't documented in the sources."}
                </p>
                <ol role="list" class="decisions">
                  {decisions.map((x, i) => {
                    const c = 'source' in x ? cite(x.source) : null;
                    const rows = decisionRows(x);
                    return (
                      <li class="decision">
                        <span class="decision__num" aria-hidden="true">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <h3>
                          {x.title}
                          {c && (
                            <>
                              {' '}
                              <a class="cite" href={c.href} aria-label={`Source ${c.n}: ${c.title}`}>
                                [{c.n}]
                              </a>
                            </>
                          )}
                        </h3>
                        {rows.length > 0 && (
                          <dl>
                            {rows.map((r) => (
                              <div>
                                <dt>{r.label}</dt>
                                <dd>{r.text}</dd>
                              </div>
                            ))}
                          </dl>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </>
            ) : (
              <ul class="list">
                {decisions.map((x) => (
                  <li>
                    <Fact value={x.title} />
                  </li>
                ))}
              </ul>
            )
          }
        </section>
        )}

        {showOutcomes && (
        <section aria-labelledby="outcomes">
          <h2 id="outcomes">Outcomes</h2>
          {d.outcomesIntro && <p>{d.outcomesIntro}</p>}
          {
            outcomes.length ? (
              <ul role="list" class="outcomes">
                {outcomes.map((o) => {
                  const c = cite(o.source);
                  return (
                    <li class="outcome">
                      <span class={`evidence evidence--${o.evidence}`}>{evidenceLabel[o.evidence]}</span>
                      <p>
                        {o.statement}
                        {c && (
                          <>
                            {' '}
                            <a class="cite" href={c.href} aria-label={`Source ${c.n}: ${c.title}`}>
                              [{c.n}]
                            </a>
                          </>
                        )}
                      </p>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p>
                <Fact value="TODO — outcomes, with evidence" />
              </p>
            )
          }
          {
            outcomes.some((o) => o.evidence === 'reported') && (
              <p class="source-note">
                “Reported” figures come from the cited source or my own account and haven't been
                independently measured.
              </p>
            )
          }
          {d.outcomesNote && <p class="callout">{d.outcomesNote}</p>}
        </section>
        )}

        {
          d.timeline.length > 0 && (
            <section aria-labelledby="timeline">
              <h2 id="timeline">Timeline</h2>
              <ol role="list" class="timeline">
                {d.timeline.map((t) => (
                  <li
                    class:list={[
                      'timeline__item',
                      { 'timeline__item--planned': t.planned, 'timeline__item--current': t.current },
                    ]}
                  >
                    <span class="timeline__period">{t.period}</span>
                    <span class="timeline__milestone">
                      {t.milestone}
                      {t.planned && <span class="timeline__tag">Proposed, not completed</span>}
                      {t.current && <span class="timeline__tag timeline__tag--current">In progress</span>}
                    </span>
                    {t.note && <span class="timeline__note">{t.note}</span>}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          hasBody && (
            <section class="prose" aria-label="Case study narrative">
              <Content />
            </section>
          )
        }

        {
          d.gallery.length > 0 && (
            <section aria-labelledby="gallery">
              <h2 id="gallery">Gallery</h2>
              <ul role="list" class="gallery">
                {d.gallery.map((g) => (
                  <li>
                    <Image src={g.src} alt={g.alt} widths={[480, 960]} sizes="(min-width: 48rem) 22rem, 92vw" />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          showReflection && d.reflection && (
            <section aria-labelledby="reflection">
              <h2 id="reflection">Reflection</h2>
              {!d.reflection.approved && (
                <p>
                  <span class="todo">Draft wording, pending Anthony's approval (dev only)</span>
                </p>
              )}
              <blockquote class="reflection">
                <p>{d.reflection.text}</p>
              </blockquote>
            </section>
          )
        }

        {
          references.length > 0 && (
            <section aria-labelledby="sources">
              <h2 id="sources">Sources</h2>
              <ol class="refs">
                {references.map((r) => (
                  <li id={`ref-${r.id}`}>
                    {r.url ? (
                      <a href={r.url} rel="noopener">
                        {r.title}
                      </a>
                    ) : (
                      <span class="refs__title">{r.title}</span>
                    )}
                    {r.publisher && <span class="refs__pub">{r.publisher}</span>}
                    {r.status === 'unverified' && <span class="evidence evidence--unverified">Not yet verified</span>}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          dev && isDraft && (
            <section class="review" aria-labelledby="review-notes">
              <h2 id="review-notes">Review notes (dev only)</h2>
              <p>Not included in production builds.</p>
              <ul>
                {d.todo.map((t) => (
                  <li>{t}</li>
                ))}
                {d.outcomes
                  .filter((o) => o.note)
                  .map((o) => (
                    <li>
                      Outcome “{o.statement}”: {o.note}
                    </li>
                  ))}
                {d.references
                  .filter((r) => r.note)
                  .map((r) => (
                    <li>
                      Source “{r.title}”: {r.note}
                    </li>
                  ))}
              </ul>
            </section>
          )
        }
      </article>
    </div>

    <nav class="page pager" aria-label="More case studies">
      {
        prev ? (
          <a class="pager__link" href={`/work/${prev.id}/`} rel="prev">
            <span class="pager__dir">
              <Icon name="arrow-left" size={16} /> Previous
            </span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="pager__link pager__link--next" href={`/work/${next.id}/`} rel="next">
            <span class="pager__dir">
              Next <Icon name="arrow-right" size={16} />
            </span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  /* Header */
  .head {
    display: grid;
    gap: var(--space-4);
    max-width: 50rem;
    padding-block: var(--space-6) var(--space-7);
  }

  .head h1 {
    font-size: clamp(2.25rem, 1.4rem + 3vw, 3.5rem);
    line-height: var(--leading-tight);
    letter-spacing: -0.025em;
  }

  .head__lead {
    max-width: 44rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .byline span + span::before {
    content: '·';
    margin-right: var(--space-3);
    color: var(--color-text-subtle);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .proof__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .proof__item::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-evergreen);
  }

  .proof__item--reported::before {
    background: var(--color-accent);
  }

  .proof__item--in-progress::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  .proof__item--unverified::before {
    background: var(--color-draft);
  }

  .draft-banner {
    justify-self: start;
    padding: var(--space-2) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--color-draft) 25%, transparent);
    border-radius: var(--radius-md);
    background: var(--color-draft-soft);
    color: var(--color-draft);
    font-size: var(--text-sm);
  }

  .cite {
    font-size: 0.8em;
    font-weight: 600;
    text-decoration: none;
    vertical-align: 0.15em;
  }

  .cite:hover {
    text-decoration: underline;
  }

  /* Cover */
  .cover {
    position: relative;
    z-index: 1;
    margin: 0 0 calc(-1 * var(--space-8));
  }

  .cover__frame {
    --tail-radius: 2rem;
    --tail-size: 3rem;
    filter: drop-shadow(0 18px 28px rgb(14 27 51 / 0.16));
  }

  .cover__frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top center;
  }

  .cover figcaption {
    margin-top: var(--space-3);
    padding-left: 3rem;
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  /* Darker band; extra top padding leaves room for the overlapping cover. */
  .lower {
    padding-block: calc(var(--space-8) + var(--space-7)) var(--space-9);
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }

  .layout {
    display: grid;
    gap: var(--space-7);
  }

  /* Sidebar */
  .meta {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .meta__card,
  .toc {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .meta__heading {
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .meta dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .meta dt {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .meta dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chips li {
    padding: 0.125rem var(--space-3);
    border-radius: 999px;
    background: var(--color-surface-muted);
  }

  .chips li:has(.todo) {
    padding: 0;
    background: none;
  }

  .toc {
    display: none;
  }

  .toc ol {
    display: grid;
    gap: var(--space-2);
  }

  .toc a {
    font-size: var(--text-sm);
