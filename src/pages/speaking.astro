---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Fact from '../components/Fact.astro';
import { contourPaths } from '../lib/topo';

const dev = import.meta.env.DEV;
const talks = (await getCollection('speaking', ({ data }) => dev || data.status === 'published')).sort(
  (a, b) => a.data.order - b.data.order,
);
const related = await Promise.all(
  talks.map((t) => (t.data.relatedWork ? getEntry(t.data.relatedWork) : undefined)),
);
const hostOf = (url: string) => {
  const host = new URL(url).hostname;
  if (host.includes('youtube')) return 'YouTube';
  if (host.includes('mediaspace')) return 'UC San Diego MediaSpace';
  if (host.includes('drive.google')) return 'Google Drive';
  return host.replace(/^www\./, '');
};

// Small contour patch for the talk panels, matching the site's topo accents.
const topo = contourPaths({
  width: 320,
  height: 220,
  step: 5,
  spacing: 12,
  levels: 24,
  offset: 8,
  wobbleRange: 110,
  peaks: [
    { x: 290, y: 30, top: 0, stretch: 1.2, phase: 0.8 },
    { x: 150, y: 10, top: -60, stretch: 1, phase: 2.2 },
  ],
});
---

<BaseLayout
  title="Speaking"
  description="Talks by Anthony Horn on building UX and web development processes for higher education."
>
  <div class="page">
    <header class="intro">
      <p class="eyebrow">Speaking</p>
      <h1>Talks and community</h1>
      <p class="intro__lead">
        I share what I've learned building processes for web and UX teams in higher education,
        from client engagement to UX improvement work with university service teams.
      </p>
    </header>
  </div>

  <div class="lower">
    <div class="page">
      <ol role="list" class="talks">
        {
          talks.map((talk, i) => {
            const t = talk.data;
            const [first, ...more] = t.appearances;
            const linkFor = (a: (typeof t.appearances)[number]) => a.links.find((l) => l.kind === 'video');
            const video = linkFor(first);
            const work = related[i];
            const where = (a: (typeof t.appearances)[number]) =>
              [`${a.event} ${a.year}`, a.location].filter(Boolean).join(', ');
            return (
              <li>
                <article class="talk" aria-labelledby={`talk-${talk.id}`}>
                  <div class="talk__panel" aria-hidden="true">
                    <svg class="talk__topo" viewBox="0 0 320 220" preserveAspectRatio="xMaxYMin slice">
                      <g fill="none" stroke="currentColor" stroke-linejoin="round">
                        {topo.map(({ d, index }) => (
                          <path d={d} stroke-width={index ? 1.2 : 0.7} opacity={index ? 0.9 : 0.55} />
                        ))}
                      </g>
                    </svg>
                    <span class="talk__year">{first.year}</span>
                    <span class="talk__event">{first.event}</span>
                    {more.length > 0 && (
                      <span class="talk__more">
                        + {more.map((a) => `${a.event} ${a.year}`).join(', ')}
                      </span>
                    )}
                    {video && (
                      <span class="talk__play">
                        <span class="talk__play-icon">
                          <Icon name="play" size={18} />
                        </span>
                        {first.durationMinutes ? `${first.durationMinutes} min` : 'Recording'}
                      </span>
                    )}
                  </div>

                  <div class="talk__body">
                    <p class="talk__meta">{t.format}</p>
                    <h2 id={`talk-${talk.id}`}>{t.title}</h2>
                    {t.coPresenters.length > 0 && (
                      <p class="talk__with">With {t.coPresenters.join(' and ')}</p>
                    )}
                    <p class="talk__summary">
                      <Fact value={t.summary} />
                    </p>

                    <ul role="list" class="appearances">
                      {t.appearances.map((a) => (
                        <li class="appearance">
                          <p class="appearance__where">
                            <span class="appearance__event">
                              <Fact value={where(a)} />
                            </span>
                            {(a.format || a.date || a.durationMinutes) && (
                              <span class="appearance__detail">
                                {[a.format, a.date, a.durationMinutes && `${a.durationMinutes} min`]
                                  .filter(Boolean)
                                  .join(' · ')}
                              </span>
                            )}
                          </p>
                          {a.links.length > 0 && (
                            <div class="appearance__links">
                              {a.links.map((l) => (
                                <a
                                  class:list={[
                                    'button',
                                    l.kind === 'video' ? 'button--primary' : 'button--secondary',
                                    'button--sm',
                                  ]}
                                  href={l.url}
                                  rel="noopener"
                                >
                                  {l.kind === 'video' && <Icon name="play" size={14} />}
                                  {l.label}
                                  {l.kind !== 'video' && <Icon name="external" size={14} />}
                                  <span class="visually-hidden">
                                    : {t.title}, {a.event} {a.year} ({hostOf(l.url)})
                                  </span>
                                </a>
                              ))}
                            </div>
                          )}
                        </li>
                      ))}
                    </ul>

                    {work && (
                      <p class="talk__related">
                        Related case study:{' '}
                        <a class="text-link" href={`/work/${work.id}/`}>
                          {work.data.title} <Icon name="arrow-right" size={16} />
                        </a>
                      </p>
                    )}

                    {dev && (t.todo.length > 0 || t.status === 'draft') && (
                      <ul class="talk__review">
                        {t.status === 'draft' && <li>Dev only: draft, hidden in production.</li>}
                        {t.todo.map((note) => (
                          <li>Dev only: {note}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              </li>
            );
          })
        }
      </ol>

      {
        dev && (
          <section class="review" aria-labelledby="community-todo">
            <h2 id="community-todo">Community contributions (dev only)</h2>
            <p>
              Not included in production builds. Add Drupal community contributions (modules, issue
              work, camp organizing, mentoring) once reviewed, each with a link that verifies it.
            </p>
          </section>
        )
      }

      <aside class="invite" aria-labelledby="invite-title">
        <div>
          <h2 id="invite-title">Looking for a speaker?</h2>
          <p>
            I'm happy to talk about UX process, design systems, and how web teams in higher
            education work with their clients.
          </p>
        </div>
        <a class="button button--primary" href="/contact/">
          Get in touch <Icon name="arrow-right" size={18} />
        </a>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    padding-block: var(--space-8) var(--space-7);
  }

  .intro h1 {
    font-size: var(--text-hero);
    line-height: var(--leading-snug);
    letter-spacing: -0.025em;
  }

  .intro__lead {
    max-width: 38rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .lower {
    padding-block: var(--space-7) var(--space-9);
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }

  .talks {
    display: grid;
    gap: var(--space-6);
  }

  .talk {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  /* Decorative panel: year, event, and length over a contour patch. */
  .talk__panel {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    gap: var(--space-1);
    min-height: 11rem;
    padding: var(--space-5);
    overflow: hidden;
    background: var(--color-text);
    color: #fff;
  }

  .talk__topo {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    color: #8fb0ff;
    opacity: 0.35;
  }

  .talk__topo path {
    vector-effect: non-scaling-stroke;
  }

  .talk__year {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .talk__event {
    font-size: var(--text-sm);
    font-weight: 600;
    color: #c9d3e3;
  }

  .talk__play {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #c9d3e3;
  }

  .talk__play-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
  }

  .talk__body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
    padding: var(--space-6);
  }

  .talk__meta {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .talk h2 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .talk__with {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .talk__summary {
    max-width: 42rem;
    color: var(--color-text-muted);
  }

  .talk__more {
    font-size: var(--text-xs);
    color: #9fb0cc;
  }

  .appearances {
    display: grid;
    width: 100%;
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .appearance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .appearance__where {
    display: grid;
    gap: 0.125rem;
  }

  .appearance__event {
    font-weight: 600;
    color: var(--color-text);
  }

  .appearance__detail {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .appearance__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .button--sm {
    min-height: 2.25rem;
    padding-inline: var(--space-4);
    font-size: var(--text-xs);
  }

  .talk__related {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .talk__related .text-link {
    display: inline;
  }

  .talk__related .text-link :global(svg) {
    display: inline;
    vertical-align: -0.2em;
  }

  .talk__review {
    margin: 0;
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-6);
    border: 1px dashed var(--color-draft);
    border-radius: var(--radius-md);
    background: var(--color-draft-soft);
    color: var(--color-draft);
    font-size: var(--text-xs);
  }

  .review {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px dashed var(--color-draft);
    border-radius: var(--radius-md);
    background: var(--color-draft-soft);
    color: var(--color-draft);
  }

  .review h2 {
    font-size: var(--text-base);
  }

  .review p {
    font-size: var(--text-sm);
  }

  .invite {
    --color-focus: #fff;
    display: grid;
    gap: var(--space-5);
    align-items: center;
    justify-items: start;
    margin-top: var(--space-7);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-text);
    color: #fff;
  }

  .invite h2 {
    font-size: var(--text-2xl);
  }

  .invite p {
    margin-top: var(--space-2);
    max-width: 36rem;
    color: #c9d3e3;
  }

  @media (min-width: 48rem) {
    .talk {
      grid-template-columns: 15rem minmax(0, 1fr);
    }

    .talk__panel {
      min-height: 100%;
    }

    .invite {
      grid-template-columns: 1fr auto;
    }
  }
</style>
