---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/anthony-portrait.jpg';
---

<section class="intro" aria-labelledby="about-title">
  <div class="intro__about">
    <Image
      class="intro__photo"
      src={portrait}
      alt="Anthony Horn, smiling with arms crossed, wearing a navy blazer in an office"
      widths={[176, 352, 528]}
      sizes="11rem"
    />
    <div class="intro__text">
      <p class="eyebrow">About</p>
      <h2 id="about-title">Developer. Designer. Problem Solver.</h2>
      <p>
        I'm Anthony Horn. I bring together design, development, and research to solve
        complex problems and create better digital experiences. Over the past 15+ years, I've
        learned that great websites aren't just about good code or beautiful interfaces—they're
        about understanding people, telling stories, and creating processes.
      </p>
      <a class="text-link" href="/about/">More about me <Icon name="arrow-right" size={16} /></a>
    </div>
  </div>

  <aside class="intro__contact" aria-labelledby="contact-title">
    <svg class="intro__bubble" viewBox="0 0 120 104" aria-hidden="true" focusable="false">
      <path
        fill-rule="evenodd"
        d="M28 4h72a18 18 0 0 1 18 18v42a18 18 0 0 1-18 18H44L16 102l6-20h0A18 18 0 0 1 10 64V22A18 18 0 0 1 28 4ZM40 43a7 7 0 1 0 0 .01ZM64 43a7 7 0 1 0 0 .01ZM88 43a7 7 0 1 0 0 .01Z"
      />
    </svg>
    <h2 id="contact-title">Let's talk</h2>
    <p>
      Interested in working together, or want to compare notes on digital experience, design
      systems, or process?
    </p>
    <a class="button button--primary" href="/contact/">
      Get in touch <Icon name="arrow-right" size={18} />
    </a>
  </aside>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .intro__about,
  .intro__contact {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-6);
  }

  .intro__about {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .intro__photo {
    width: 11rem;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
  }

  .intro__text {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .intro__text h2,
  .intro__contact h2 {
    font-size: var(--text-2xl);
  }

  /* Short accent rule under the heading. */
  .intro__contact h2::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-top: var(--space-3);
    border-radius: 2px;
    background: #fff;
  }

  /* Watermark: a large, faint speech bubble tucked into the upper-right. */
  .intro__bubble {
    position: absolute;
    top: -1.25rem;
    right: -1.75rem;
    z-index: -1;
    width: 11rem;
    fill: #fff;
    opacity: 0.07;
    transform: rotate(-8deg);
    pointer-events: none;
  }

  .intro__text p,
  .intro__contact p {
    color: var(--color-text-muted);
    max-width: 36rem;
  }

  .intro__contact {
    --color-focus: #fff;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: var(--space-4);
    align-content: center;
    justify-items: start;
    background: var(--color-text);
    border-color: var(--color-text);
    color: #fff;
  }

  .intro__contact p {
    color: #c9d3e3;
  }

  @media (min-width: 40rem) {
    .intro__about {
      grid-template-columns: auto 1fr;
    }
  }

  @media (min-width: 72rem) {
    .intro {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }
</style>
