---
/**
 * Decorative topographic contour lines for the upper-right of the page: a main
 * summit off the top-right edge plus a smaller secondary peak. Generated at
 * build time; no runtime JS.
 */
import { contourPaths } from '../lib/topo';

const W = 600;
const H = 480;
const paths = contourPaths({
  width: W,
  height: H,
  peaks: [
    { x: 560, y: 40, top: 0, stretch: 1.15, phase: 0 }, // main summit
    { x: 290, y: 60, top: -160, stretch: 1.05, phase: 2.1 }, // smaller peak
  ],
});
---

<svg
  class="topo"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMaxYMin slice"
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round">
    {
      paths.map(({ d, index }) => (
        <path d={d} stroke-width={index ? 1.4 : 0.8} opacity={index ? 0.9 : 0.55} />
      ))
    }
  </g>
</svg>

<style>
  .topo {
    position: absolute;
    top: 0;
    right: 0;
    z-index: -1;
    width: min(52rem, 85%);
    height: auto;
    aspect-ratio: 600 / 480;
    color: var(--color-accent);
    opacity: 0.22;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 85% 85% at 100% 0%, #000 40%, transparent 85%);
  }
</style>
