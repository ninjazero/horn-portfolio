---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { contourPaths } from '../lib/topo';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// Sidebar contour patch: a summit near the bottom-left and a lower rise beside it.
const railTopo = contourPaths({
  width: 240,
  height: 320,
  step: 5,
  spacing: 13,
  levels: 22,
  offset: 10,
  wobbleRange: 120,
  peaks: [
    { x: 70, y: 285, top: 0, stretch: 1.2, phase: 0.6 },
    { x: 190, y: 200, top: -70, stretch: 1.0, phase: 2.4 },
  ],
});
---

<header class="rail">
  <div class="rail__top">
    <a class="brand" href="/">
      <Logo class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__descriptor">{site.descriptor}</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      <Icon name="menu" class="menu-toggle__open" />
      <Icon name="close" class="menu-toggle__close" />
      <span class="visually-hidden">Menu</span>
    </button>
  </div>

  <nav id="primary-nav" class="nav" aria-label="Primary" data-menu>
    <ul role="list" class="nav__list">
      {
        nav.map((item) => (
          <li>
            <a
              class="nav__link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              <Icon name={item.icon} />
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="rail__art" aria-hidden="true">
    <svg viewBox="0 0 240 320" preserveAspectRatio="xMinYMax slice" focusable="false">
      <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round">
        {
          railTopo.map(({ d, index }) => (
            <path d={d} stroke-width={index ? 1.3 : 0.75} opacity={index ? 0.9 : 0.55} />
          ))
        }
      </g>
    </svg>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.dataset.open = String(open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close if the viewport grows past the mobile breakpoint while open.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .rail {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .rail__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-text);
  }

  .brand :global(.brand__mark) {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
  }

  .brand__text {
    display: grid;
    line-height: 1.25;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brand__descriptor {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .menu-toggle :global(.menu-toggle__close),
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__close) {
    display: block;
  }

  .nav {
    padding: 0 var(--gutter) var(--space-3);
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .nav__link:hover {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .nav__link[aria-current='page'] {
    background: var(--color-nav-active);
    color: #fff;
  }

  .rail__art {
    display: none;
  }

  /* Mobile: collapse the list behind the toggle only when JS is available,
     so the nav stays usable without JavaScript. */
  @media (max-width: 63.99rem) {
    :global(.js) .menu-toggle {
      display: grid;
    }

    :global(.js) .nav:not([data-open='true']) {
      display: none;
    }

    :global(.js) .nav__list {
      flex-direction: column;
    }
  }

  /* Desktop: persistent left rail. */
  @media (min-width: 64rem) {
    .rail {
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100dvh;
      border-bottom: 0;
      border-right: 1px solid color-mix(in srgb, var(--color-border), var(--color-border-strong));
      box-shadow: 2px 0 12px -4px rgb(14 27 51 / 0.08);
    }

    .rail__top {
      padding: var(--space-6) var(--space-5) var(--space-6);
    }

    /* Media object: mark on the left, name and descriptor beside it. */
    .brand {
      align-items: flex-start;
    }

    .nav {
      padding: 0 var(--space-4);
    }

    .nav__list {
      flex-direction: column;
    }

    /* Contour patch fills the space under the nav, anchored bottom-left and
       fading out toward the links. */
    .rail__art {
      display: block;
      flex: 1 1 0;
      min-height: 0;
      margin-top: var(--space-5);
      color: var(--color-accent);
      opacity: 0.3;
      pointer-events: none;
      mask-image: linear-gradient(to top, #000 45%, transparent);
    }

    .rail__art svg {
      width: 100%;
      height: 100%;
    }

    /* Keep line weight constant however much the patch is scaled. */
    .rail__art path {
      vector-effect: non-scaling-stroke;
    }
  }
</style>
