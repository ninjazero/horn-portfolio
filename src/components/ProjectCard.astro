---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'work'>;
  /** Varies the placeholder cover so neighbouring cards don't look identical. */
  variant?: number;
  headingLevel?: 'h2' | 'h3';
  /** Show the organization above the title (used on the Work index). */
  showOrganization?: boolean;
  /** Responsive `sizes` for the cover; override when the card is wider than on the homepage. */
  sizes?: string;
}

const {
  project,
  variant = 0,
  headingLevel: Heading = 'h3',
  showOrganization = false,
  sizes = '(min-width: 90rem) 22rem, (min-width: 48rem) 45vw, 92vw',
} = Astro.props;
const { title, organization, summary, category, cover, coverAlt, coverStyle, status } = project.data;
const href = `/work/${project.id}/`;
const hues = ['#1f4fe0', '#2f5d50', '#5b4bc4', '#0f6b8f'];
const hue = hues[variant % hues.length];
---

<article class="card">
  <div class="card__media" data-cover-style={cover ? coverStyle : undefined} style={`--hue: ${hue}`}>
    {
      cover ? (
        <Image src={cover} alt={coverAlt ?? ''} widths={[360, 560, 720, 1080]} sizes={sizes} />
      ) : (
        <div class="card__placeholder">
          <svg viewBox="0 0 320 180" aria-hidden="true" focusable="false">
            <rect x="24" y="24" width="272" height="156" rx="8" fill="#fff" />
            <rect x="24" y="24" width="272" height="20" rx="8" fill="var(--hue)" opacity="0.14" />
            <circle cx="38" cy="34" r="3" fill="var(--hue)" opacity="0.5" />
            <circle cx="48" cy="34" r="3" fill="var(--hue)" opacity="0.35" />
            <circle cx="58" cy="34" r="3" fill="var(--hue)" opacity="0.2" />
            <rect x="40" y="60" width="120" height="10" rx="3" fill="var(--hue)" opacity="0.55" />
            <rect x="40" y="78" width="180" height="6" rx="3" fill="#0e1b33" opacity="0.12" />
            <rect x="40" y="90" width="150" height="6" rx="3" fill="#0e1b33" opacity="0.12" />
            <rect x="40" y="112" width="70" height="52" rx="5" fill="var(--hue)" opacity="0.12" />
            <rect x="120" y="112" width="70" height="52" rx="5" fill="var(--hue)" opacity="0.08" />
            <rect x="200" y="112" width="70" height="52" rx="5" fill="var(--hue)" opacity="0.12" />
          </svg>
          <span class="card__placeholder-note">Image TODO</span>
        </div>
      )
    }
    <span class="card__tag">{category}</span>
  </div>

  <div class="card__body">
    {status === 'draft' && <span class="card__draft">Draft · unverified</span>}
    {showOrganization && <p class="card__org">{organization}</p>}
    <Heading class="card__title">
      <a href={href}>{title}</a>
    </Heading>
    <p class="card__summary">{summary}</p>
    <span class="card__more" aria-hidden="true">
      View case study <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card:focus-within {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-muted);
  }

  .card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Tilted cover: the screenshot sits angled in 3D on a tinted ground and
     bleeds off the bottom-right; the card's rounded frame masks it. */
  .card__media[data-cover-style='tilt'] {
    overflow: hidden;
    background: linear-gradient(150deg, color-mix(in srgb, var(--hue) 14%, #fff), color-mix(in srgb, var(--hue) 6%, var(--color-surface-muted)));
  }

  .card__media[data-cover-style='tilt'] :global(img) {
    inset: auto;
    top: 24%;
    left: 12%;
    width: 96%;
    height: auto;
    aspect-ratio: auto;
    border-radius: var(--radius-sm);
    box-shadow:
      0 2px 4px rgb(14 27 51 / 0.08),
      0 16px 32px -8px rgb(14 27 51 / 0.28);
    transform-origin: top left;
    transform: perspective(900px) rotateY(-14deg) rotateX(8deg) rotate(-5deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .card:hover .card__media[data-cover-style='tilt'] :global(img) {
    transform: perspective(900px) rotateY(-10deg) rotateX(6deg) rotate(-4deg) translateY(-4px);
  }

  .card__placeholder {
    position: relative;
    height: 100%;
    background: linear-gradient(160deg, color-mix(in srgb, var(--hue) 12%, #fff), var(--color-surface-muted));
  }

  .card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .card__placeholder-note {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-2);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-subtle);
  }

  .card__tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 0.125rem var(--space-3);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .card__draft {
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-draft-soft);
    color: var(--color-draft);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .card__org {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .card__title {
    font-size: var(--text-lg);
  }

  .card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Whole card is clickable via the title link; one tab stop per card. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .card__more :global(svg) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .card:hover .card__more :global(svg) {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
